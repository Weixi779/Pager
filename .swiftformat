--indent 4
--swiftversion 6.0
--exclude .build,.swiftpm
--self remove
--acronyms URL,UUID
--disable wrapAttributes,wrapMultilineStatementBraces
--wraparguments before-first
--wrapparameters before-first
--allow-partial-wrapping false
--closingparen balanced
--callsiteparen balanced
--trailingcommas collections-only
